# ---------------------------------------------------------------------------
# Copy to .env for local docker-compose, or set these as Railway variables.
# NOTHING in here may be committed with real values.
# ---------------------------------------------------------------------------

# --- Database (Railway PostgreSQL provides DATABASE_URL automatically) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/tutor
DATABASE_USERNAME=tutor
DATABASE_PASSWORD=tutor

# --- Google OAuth 2.0 client (console.cloud.google.com > Credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- URLs ---
# Public URL of the backend service (used to build the OAuth redirect URI).
APP_API_BASE_URL=http://localhost:8080
# Public URL of the Angular SPA (post-login redirect + CORS allow-list).
APP_WEB_BASE_URL=http://localhost:4200
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- App session JWT (HS256). Use >= 32 random bytes in production. ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes
JWT_TTL=PT12H
# When the SPA and API are on different domains you MUST set:
#   JWT_COOKIE_SECURE=true
#   JWT_COOKIE_SAMESITE=None
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# --- Encryption at rest for stored Google tokens (AES key, base64, 32 bytes) ---
# generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Frontend container -> backend (used by nginx in the frontend image) ---
BACKEND_URL=http://localhost:8080
